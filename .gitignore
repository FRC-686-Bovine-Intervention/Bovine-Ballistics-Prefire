*.app

# Crashlytics generated file
GUI/crashlytics-build.properties

# TestRunner generated files
GUI/InitTestScene*.unity*

# Addressables default ignores, before user customizations
GUI/ServerData
GUI/[Aa]ssets/StreamingAssets/aa*
GUI/[Aa]ssets/AddressableAssetsData/link.xml*
GUI/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
GUI/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
GUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
GUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
GUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
GUI/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
GUI/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

